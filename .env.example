# Environment Configuration Template (Copy to .env for local overrides)
# NEVER commit real API keys or passwords. Production secrets are injected via GCP Secret Manager.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True

# Strategic Model Routing
FAST_MODEL_NAME=gemini-3.8-flash
PLANNER_MODEL_NAME=gemini-3.1-pro-preview

# Persistent Session & Order Store
# Local default uses async SQLite (sqlite+aiosqlite:///./.adk/sessions.db).
# In Cloud Run, INSTANCE_CONNECTION_NAME + Secret Manager DB_PASS enable PostgreSQL Cloud SQL.
ORDER_STORE_DB_PATH=.adk/orderguard_store.db
SESSION_DB_URL=sqlite+aiosqlite:///./.adk/orderguard_sessions.db

# Secret Manager Secret IDs (resolved at runtime via google-cloud-secret-manager)
DB_PASSWORD_SECRET_ID=ai-project-db-password
REFUND_SIGNING_SECRET_ID=ai-project-refund-signing-key

# Observability, Tracing & Privacy
OTEL_SERVICE_NAME=ai-project
ENABLE_CLOUD_TRACE_EXPORT=false
ENABLE_CLOUD_DLP=false
HUMAN_APPROVAL_REFUND_THRESHOLD_USD=0.01
MAX_AUTO_POLICY_REFUND_USD=1000.00
